rules_version = '2';
// Trigger: firebaserules.admin-rechten toegevoegd aan service-account, deploy opnieuw testen
service cloud.firestore {
  match /databases/{database}/documents {

    function ingelogd() {
      return request.auth != null;
    }

    function rol() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isKashouderOfBeheerder() {
      return ingelogd() && (rol() == 'kashouder' || rol() == 'beheerder');
    }

    function isBeheerder() {
      return ingelogd() && rol() == 'beheerder';
    }

    match /users/{userId} {
      allow read: if ingelogd();
      allow write: if ingelogd() && (request.auth.uid == userId || isBeheerder());
      // NIEUW: kashouder mag specifiek het lottoSaldo-veld van een
      // ander lid bijwerken (storting registreren / automatisch
      // verrekenen — lib/firestore-payments.ts). Beheerder kon dit al
      // via de regel hierboven; deze regel dekt alleen de kashouder-rol.
      allow update: if isKashouderOfBeheerder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lottoSaldo']);
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if ingelogd() && request.auth.uid == userId;
    }

    match /users/{userId}/notificationSettings/{docId} {
      allow read, write: if ingelogd() && request.auth.uid == userId;
    }

    match /betalingen/{betalingId} {
      allow read: if ingelogd();
      // Zowel "voor jezelf" (defensief, huidige code gebruikt dit pad
      // niet meer actief) als "kashouder/beheerder maakt namens een
      // ander lid aan" (wél actief gebruikt — zie
      // verrekenLottoSaldoMetOpenstaandeWeek in lib/firestore-payments.ts,
      // aangeroepen vanuit stortLottoSaldo. Zonder deze uitzondering
      // zou de kashouder geblokkeerd worden zodra een lid nog
      // helemaal geen betaaldocument voor de huidige week heeft).
      allow create: if ingelogd() && (
        request.resource.data.userId == request.auth.uid ||
        isKashouderOfBeheerder()
      );
      allow update: if isKashouderOfBeheerder();
      allow delete: if false;
    }

    match /kasmutaties/{mutatieId} {
      allow read: if ingelogd();
      allow create: if isKashouderOfBeheerder();
      allow update, delete: if false;
    }

    match /auditLog/{entryId} {
      allow read: if ingelogd();
      allow create: if ingelogd() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /paymentConfig/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    // NIEUW: voor Naam vereniging / Standaard inleg (Beheer → Instellingen)
    match /verenigingConfig/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    match /spelConfig/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    match /prijsConfig/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    match /seizoenen/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }


    match /trekkingen/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    match /resultaten/{docId} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }

    match /invites/{token} {
      // Lezen moet PUBLIEK zijn (ook zonder inlog) — iemand die een
      // uitnodigingslink opent is per definitie nog niet ingelogd op
      // het moment dat de pagina checkt of de link geldig lijkt. Dit
      // is puur een UX-check; de doorslaggevende validatie gebeurt
      // altijd opnieuw, server-side, in de Cloud Function
      // verzilverUitnodiging bij het daadwerkelijk verzilveren.
      allow read: if true;
      // Aanmaken: alleen kashouder/beheerder.
      allow create: if isKashouderOfBeheerder();
      // Nooit vanaf de client bijwerken of verwijderen — het
      // markeren als 'gebruikt' gebeurt uitsluitend via de Cloud
      // Function (Admin SDK, omzeilt deze regels toch al). Zonder
      // deze restrictie zou een kwaadwillende de gebruikt/vervalOp-
      // velden zelf kunnen manipuleren.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if ingelogd();
      allow write: if isBeheerder();
    }
  }
}
